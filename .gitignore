# ---- Mavis runtime data（不提交，是 Mavis 自己的状态） ----
.workbuddy/
.tmp/
dev/

# ---- Build artifacts（除 dist/）----
*.exe
*.obj
*.lib
*.exp
*.pdb
*.test
*.out

# ---- Build output dirs except dist/（dist/ 里有要拷 U 盘的 spike 产物）----
bin/
obj/

# ---- dist/ 里的 spike 产物要保留（docs/08 让用户直接拷 U 盘） ----
!dist/
!dist/spike386/*.exe
!dist/spike64/*.exe
# ---- dist/ 根下的 smith.exe / smith64.exe 也保留（Phase 1 产物） ----
!dist/smith.exe
!dist/smith64.exe

# ---- PE 探针运行时写的测试文件 ----
*.pe_spike_*.txt
dist/spike386/pe_spike_*.txt
dist/spike64/pe_spike_*.txt

# ---- smith.exe 运行时写的早期日志（用户拿来看 PE 启动失败原因的） ----
# 不入仓；是本地诊断文件
dist/smith.log
.tmp/smith.log

# ---- API key 文件（首次运行 dialog 勾选"保存到磁盘"会创建） ----
# 不入仓；是用户隐私 + 部署到别人机器的 U 盘不带这文件（dialog 弹回输入）
smith.key
smith.ini
.tmp/smith.key
.tmp/smith.ini

# ---- OS / editor temp ----
Thumbs.db
.DS_Store
*~
*.swp
*.swo
.vs/
.idea/
*.user
